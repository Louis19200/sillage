# Source des données de l'œuvre : "fixtures" (défaut) ou "api".
VITE_DATA_SOURCE=fixtures
# Utilisés seulement avec VITE_DATA_SOURCE=api.
VITE_API_URL=http://localhost:8787
# Jeton de lecture. Attention : toute variable VITE_* finit dans le bundle client.
VITE_API_TOKEN=
# Moteur v2 : premier jour de la chaîne de sélection, utile seulement avant le premier gel des styles par l'API.
