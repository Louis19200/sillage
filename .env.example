# API
# URL de l'API déployée (utilisée par `pnpm --filter api check:prod`)
API_URL=
DATABASE_URL=postgres://sillage:sillage@localhost:5432/sillage
# true sur Vercel + Neon (URL du pooler, « -pooler » dans l'hôte) : client postgres max 1, sans requêtes préparées
DATABASE_SERVERLESS=
INGEST_TOKEN=remplace-moi-par-openssl-rand-hex-32
# Token de lecture seule pour la page d'art (finit dans le bundle client). 32 caractères min, ≠ INGEST_TOKEN.
# Accepté sur /day et /range quand PROTECT_READS=true, jamais en écriture.
READ_TOKEN=
# true = /day et /range exigent READ_TOKEN ou INGEST_TOKEN (défaut : true si NODE_ENV=production)
PROTECT_READS=
# Origines autorisées (CORS) sur /day et /range, séparées par des virgules. Vide = pas de CORS.
# ex. https://sillage-art.vercel.app,http://localhost:5173
CORS_ORIGINS=
# Secret des routes GET /cron/:name (Vercel l'envoie en Authorization: Bearer). Vide = /cron répond 503.
CRON_SECRET=
PORT=8787
# true = node-cron lance les tâches en local (inutile sur Vercel : voir CRON_SECRET)
ENABLE_JOBS=

# Collecteur GitHub (token personnel en lecture seule)
GITHUB_TOKEN=
GITHUB_LOGIN=

# Alertes (phase 7)
ALERT_EMAIL=
