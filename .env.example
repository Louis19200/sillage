# API
# URL de l'API déployée (utilisée par `pnpm --filter api check:prod`)
API_URL=
# Adresse de la page d'art (vérification du CORS par check-prod)
ART_URL=
DATABASE_URL=postgres://sillage:sillage@localhost:5432/sillage
# true sur Vercel + Neon (URL du pooler, « -pooler » dans l'hôte) : client postgres max 1, sans requêtes préparées
DATABASE_SERVERLESS=
INGEST_TOKEN=remplace-moi-par-openssl-rand-hex-32
# Token de lecture seule pour la page d'art (finit dans le bundle client). 32 caractères min, ≠ INGEST_TOKEN.
# Accepté sur /day et /range quand PROTECT_READS=true, jamais en écriture.
READ_TOKEN=
# true = /day et /range exigent READ_TOKEN ou INGEST_TOKEN (défaut : true si NODE_ENV=production)
PROTECT_READS=
# Origines autorisées (CORS) sur /day et /range, séparées par des virgules. Vide = pas de CORS.
# ex. https://sillage-art.vercel.app,http://localhost:5173
CORS_ORIGINS=
# Secret des routes GET /cron/:name (Vercel l'envoie en Authorization: Bearer). Vide = /cron répond 503.
CRON_SECRET=
PORT=8787
# true = node-cron lance les tâches en local (inutile sur Vercel : voir CRON_SECRET)
ENABLE_JOBS=

# Collecteur GitHub (token personnel en lecture seule)
GITHUB_TOKEN=
GITHUB_LOGIN=

# Contexte de la journée (phase 8, voir docs/sources/weather.md) : position « maison » pour la météo des jours
# sans position du téléphone (tout l'historique avant l'app). Arrondie à 2 décimales (~1 km) par l'API, ex. 48.85 / 2.35.
HOME_LAT=
HOME_LON=
# Fuseau des journées locales pour « hier » et le Kp (défaut Europe/Paris)
CONTEXT_TZ=

# Alertes (phase 7, voir docs/DEPLOY.md « Surveillance ») : notifications ntfy sur le téléphone.
# Topic long et impossible à deviner (quiconque le connaît lit les alertes). Vide = alertes dans les journaux seulement.
NTFY_TOPIC=
# Facultatifs : serveur ntfy (défaut https://ntfy.sh) et token d'accès ntfy
NTFY_SERVER=
NTFY_TOKEN=
# Facultatif : ntfy transfère aussi chaque alerte à cette adresse e-mail (nécessite NTFY_TOPIC)
ALERT_EMAIL=

# Galerie (art/, phase 6) : première année proposée dans la vue année (défaut 2019)
VITE_GALLERY_FIRST_YEAR=
# Script art/scripts/render-yesterday.ts (Node) : API et jeton de LECTURE (sinon VITE_API_URL / VITE_API_TOKEN, sinon fixtures)
SILLAGE_API_URL=
SILLAGE_READ_TOKEN=
