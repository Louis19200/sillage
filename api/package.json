{
  "name": "@sillage/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "db:pglite": "tsx scripts/pglite-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "github:backfill": "tsx scripts/backfill-github.ts",
    "github:sync": "tsx scripts/backfill-github.ts --days 7",
    "vercel:check": "tsc -p api/tsconfig.json && tsx api/_smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@sillage/shared": "workspace:*",
    "hono": "^4.6.0",
    "node-cron": "^4.0.0",
    "postgres": "^3.4.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
